[gd_resource type="Theme" load_steps=60 format=3]

; Fronts of War UI theme - the single visual source of truth for every
; Control node (docs/UI_DESIGN_SPEC.md, docs/DECISIONS.md D54). Applied
; project-wide via gui/theme/custom in project.godot. Colors are mirrored
; for _Draw code in src/UI/Theme/UiPalette.cs; keep the two in step.
;
; Type variations (set Control.ThemeTypeVariation to use):
;   Dark HUD text:  TitleLabel HeadingLabel CardHeadingLabel SubheadingLabel BodyLabel
;                   SmallLabel NumberLabel MonoLabel CaptionLabel
;   Paper text:     PaperTitleLabel PaperHeadingLabel PaperCardHeadingLabel PaperSubheadingLabel
;                   PaperBodyLabel PaperSmallLabel PaperNumberLabel
;                   PaperMonoLabel StampLabel
;   World overlay:  DamageNumberLabel
;   Panels:         SlatePanel SlatePanelStrong PaperPanel FramePanel
;                   WoodRailPanel TeletypePanel SlotPanel
;   Buttons:        (Button = slate default) PrimaryButton PaperButton
;                   CardButton GhostButton
;   Rich text:      PaperRichText
;   Separators:     (HSeparator = slate) PaperSeparator

